{
  "name": "precision_residual_confirm_tool_hang",
  "task": "ToolHang",
  "description": "Precision-Residual PhaseForge for ToolHang benchmark task. Memoryless dual-stream policy: warm-started direct action base (partial_warm, drop_rate=0.5) + residual compliance branch (beta=0.0) + direct gripper head + unfrozen encoder (encoder_lr_scale=0.1) + margin prototype routing (margin=0.5, lambda_margin=0.05). Lipschitz and gain regularization disabled. Release loss disabled.",
  "seeds": [42, 43, 44],
  "defaults": ["train.early_stopping.enabled=false"],
  "methods": [
    {
      "index": 1,
      "name": "precision_residual_phaseforge",
      "role": "Precision-Residual PhaseForge proposed method",
      "model": "precision_residual_phaseforge",
      "data": "tool_hang",
      "task": "ToolHang",
      "stages": [1, 2],
      "stage2_source": "self",
      "evaluate": true,
      "evaluate_mode": "rollout",
      "overrides": [
        "topo@_global_=topo_pelt_k6",
        "train.supcon.enabled=true",
        "train.margin.enabled=true",
        "train.margin.lambda_margin=0.05",
        "train.lipschitz.enabled=false",
        "train.gain_reg.enabled=false",
        "train.dim_weights=[1.0,1.0,2.0,1.0,1.0,1.0,2.0]",
        "train.release_loss.enabled=false",
        "train.log_dimension_mse=true",
        "eval.episodes.trace_level=full"
      ]
    },
    {
      "index": 2,
      "name": "pf_direct_supcon_margin",
      "role": "PhaseForge-direct control with SupCon + margin routing",
      "model": "phaseforge_prototype",
      "data": "tool_hang",
      "task": "ToolHang",
      "stages": [1, 2],
      "stage2_source": "self",
      "evaluate": true,
      "evaluate_mode": "rollout",
      "overrides": [
        "topo@_global_=topo_pelt_k6",
        "train.supcon.enabled=true",
        "train.margin.enabled=true"
      ]
    }
  ]
}
