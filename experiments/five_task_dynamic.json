{
  "name": "five_task_dynamic",
  "task": "all",
  "description": "PhaseForge 2.0 dynamics-aware primary method. Dynamic-regime discovery is enabled through the switching-linear K=6 configuration; each selected cell runs Stage 1, Stage 2 bootstrapped from its own Stage 1 checkpoint, and final rollout evaluation.",
  "seeds": [42, 43, 44],
  "defaults": ["train.early_stopping.enabled=false"],
  "tasks": ["Lift", "Can", "Square", "ToolHang", "Transport"],
  "methods": [
