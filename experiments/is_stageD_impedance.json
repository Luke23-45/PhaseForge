      "data": "can",
      "task": "Can",
      "stages": [1],
      "evaluate": true,
      "evaluate_mode": "rollout"
    },
    {
      "index": 2,
      "name": "bc_impedance",
      "role": "BC-impedance action-matched control",
      "model": "baselines/bc_impedance",
      "data": "can",
      "task": "Can",
      "stages": [1],
      "evaluate": true,
      "evaluate_mode": "rollout"
    },
    {
      "index": 3,
      "name": "pf_direct_supcon_margin",
      "role": "PhaseForge-direct with SupCon + margin prototype routing",
      "model": "phaseforge_prototype",
      "data": "can",
      "task": "Can",
      "stages": [1, 2],
      "stage2_source": "self",
      "evaluate": true,
      "evaluate_mode": "rollout",
      "overrides": [
        "topo@_global_=topo_pelt_k6",
        "train.supcon.enabled=true",
        "train.margin.enabled=true"
      ]
    },
    {
      "index": 4,
      "name": "pf_impedance_supcon_margin",
      "role": "PhaseForge-impedance with SupCon + margin routing",
      "model": "is_phaseforge",
      "data": "can",
      "task": "Can",
      "stages": [1, 2],
      "stage2_source": "self",
      "evaluate": true,
      "evaluate_mode": "rollout",
      "overrides": [
        "topo@_global_=topo_pelt_k6",
        "train.supcon.enabled=true",
        "train.margin.enabled=true"
      ]
    },
    {
      "index": 5,
      "name": "is_full",
      "role": "Full IS-PhaseForge with contraction regularization",
      "model": "is_phaseforge",
      "data": "can",
      "task": "Can",
      "stages": [1, 2],
      "stage2_source": "self",
      "evaluate": true,
      "evaluate_mode": "rollout",
      "overrides": [
        "topo@_global_=topo_pelt_k6",
        "train.supcon.enabled=true",
        "train.margin.enabled=true",
        "train.lipschitz.enabled=true",
        "train.gain_reg.enabled=true"
      ]
