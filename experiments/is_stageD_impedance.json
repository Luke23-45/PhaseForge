{
  "name": "is_stageD_impedance",
  "task": "Can",
  "description": "IS-PhaseForge Stage D: impedance action parameterization (Professor §12D, the §7.5 action-matched matrix). Isolates the expert action parameterization: BC-direct vs BC-impedance vs PhaseForge-direct (+SupCon+margin) vs PhaseForge-impedance (+SupCon+margin) vs full IS-PhaseForge (+contraction). Cells 1-2/4-5 are the controlled §7.5 comparison.",
  "seeds": [42, 43, 44],
  "defaults": ["train.early_stopping.enabled=false"],
  "methods": [
    {
      "index": 1,
      "name": "bc_direct",
      "role": "BC-direct floor",
